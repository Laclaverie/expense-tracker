*.anon.*
# Written next to the statements by bank-tools\*.bat (personal data)
reveal.txt
anonymize-extra.txt
*.dump.txt
*.shape.txt
anonymized/
data/
private/
.env
# Databases (real ones, copies, demo and anonymized developer copies): never committed
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite.restore
*.sqlite.previous
*.sqlite.download
*.db
dev-data/
# Phone app files (apps/mobile/lib/phone_store.dart): pairing.json holds the pairing secret
pairing.json
last.json

# Signing keys (a future release key for the phone app): never committed
*.jks
*.keystore
key.properties

# Personal agent notes of the machine owner
CLAUDE.local.md

